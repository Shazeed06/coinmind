# Copy to .env.local for local dev, and set the same keys in your Vercel
# project's Environment Variables for production. Never commit real secrets.

# Newsletter signup (app/api/subscribe). Only the API key is required; the
# audience id defaults to the CoinMind "General" audience in code and only needs
# setting to target a different list. Without the key, the signup form reports
# that subscribing is unavailable instead of dropping the email.
RESEND_API_KEY=
# RESEND_AUDIENCE_ID=   # optional override; defaults to the General audience

# Optional: protects GET /api/indexnow so only requests sending this secret in
# the x-indexnow-secret header can trigger an IndexNow submission.
INDEXNOW_SECRET=
